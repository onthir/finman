# Postgres connection string. Local: postgres://postgres:postgres@localhost:5432/finman
DATABASE_URL=

# 32 raw bytes, hex (64 chars) or base64. Used to encrypt Plaid access tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# NextAuth (Auth.js v5)
# Generate: openssl rand -base64 32
AUTH_SECRET=
# Public URL of the app (http://localhost:3000 in dev)
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Resend — for magic-link email + payment reminders
# https://resend.com/api-keys
RESEND_API_KEY=
AUTH_EMAIL_FROM=onboarding@resend.dev

# Plaid — https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | development | production
PLAID_ENV=sandbox
# Publicly reachable URL for Plaid webhooks. Use ngrok in dev:
#   ngrok http 3000  →  https://<id>.ngrok-free.app/api/plaid/webhook
PLAID_WEBHOOK_URL=

# Anthropic — for AI categorization & insights (Claude Haiku 4.5)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Inngest — optional. Leave empty in dev; the local Inngest dev server picks it up.
# https://app.inngest.com/env/production/manage/signing-key
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
